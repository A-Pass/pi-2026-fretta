APP_PORT=3000
APP_HOST=localhost
APP_EXTERNAL_PORT=3100
NODE_ENV=production
APP_URL=http://localhost:3000
APP_BETTER_AUTH_SECRET=replace-with-a-long-random-secret
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=

# Valores usados pelo frontend. O modo demo usa dados locais; real usa a API.
NEXT_PUBLIC_API_MODE=demo
# Opcional. Quando vazio, o mapa usa o tile padrão do OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=

# Opcional: credenciais do painel administrativo.
# FRETTA_ADMIN_SECRET pode usar o APP_BETTER_AUTH_SECRET quando não for definido.
FRETTA_ADMIN_USERNAME=
FRETTA_ADMIN_PASSWORD=
FRETTA_ADMIN_SECRET=

# Habilite somente no ambiente local da apresentação.
FRETTA_DEMO_PIX=false

# Opcional: endpoint /reverse de um geocodificador compatível com Nominatim administrado pela equipe.
FRETTA_REVERSE_GEOCODER_URL=

DB_HOST=database
DB_PORT=5432
DB_USER=fretta
DB_NAME=fretta
DB_PASSWORD=replace-with-a-strong-password
DB_URL=postgresql://fretta:replace-with-a-strong-password@database:5432/fretta
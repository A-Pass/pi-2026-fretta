// ============================================================================
// SCHEMA: Aplicativo de Fretes — Prisma + Better Auth
// Banco: PostgreSQL 13+
// Auth: Better Auth (adapter Prisma), com login social Google e Apple
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MODELOS DO BETTER AUTH
// Estrutura padrão exigida pelo adapter Prisma do Better Auth. Os nomes de
// modelo/campo em camelCase seguem a convenção que o `better-auth` espera;
// as tabelas no banco ficam em snake_case via @map/@@map.
// Documentação: https://www.better-auth.com/docs/adapters/prisma
// ============================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?

  // --- Campos adicionais do domínio (configurados via `user.additionalFields`
  //     no better-auth, para trafegarem no signup/sessão) ---
  documento     String?  @unique // CPF ou CNPJ
  telefone      String?
  accountSetupComplete Boolean @default(false) @map("account_setup_complete")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions  Session[]
  accounts  Account[]

  cliente   Cliente?
  motorista Motorista?
  companyProfile DriverCompanyProfile?
  operatingArea  OperatingArea?
  savedAddresses SavedAddress[]
  notifications  AppNotification[]
  messagesSent   Mensagem[] @relation("MensagemRemetente")
  messagesReceived Mensagem[] @relation("MensagemDestinatario")
  reviewsGiven   Avaliacao[] @relation("AvaliacaoAvaliador")
  reviewsReceived Avaliacao[] @relation("AvaliacaoAvaliado")
  adminReviews   AdminReview[]
  freightAgreements AcordoFrete[] @relation("AcordoMotorista")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

// Guarda tanto login social (Google, Apple) quanto login por senha.
// Para OAuth: providerId = "google" | "apple", accountId = id do usuário no provedor.
// Para credenciais: providerId = "credential", password = hash da senha.
model Account {
  id         String @id @default(cuid())
  accountId  String @map("account_id")
  providerId String @map("provider_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String? // usado somente no provider "credential"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@map("account")
}

// Usado para verificação de e-mail e fluxos de "magic link" / troca de senha
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("verification")
}

// ============================================================================
// ENUMS DO DOMÍNIO
// ============================================================================

enum Porte {
  PEQUENO
  MEDIO
  GRANDE

  @@map("porte_enum")
}

enum StatusFrete {
  ABERTO
  EM_NEGOCIACAO
  ACEITO
  EM_TRANSPORTE
  CONCLUIDO
  CANCELADO

  @@map("status_frete_enum")
}

enum StatusProposta {
  PENDENTE
  ACEITA
  REJEITADA
  CANCELADA

  @@map("status_proposta_enum")
}

// ============================================================================
// ENDEREÇOS
// ============================================================================

model Endereco {
  id          String  @id @default(cuid())
  logradouro  String
  numero      String?
  complemento String?
  bairro      String?
  cidade      String
  estado      String  @db.Char(2)
  cep         String
  pais        String  @default("Brasil")
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now()) @map("created_at")

  clientes        Cliente[]
  fretesOrigem    Frete[]   @relation("FreteEnderecoOrigem")
  fretesDestino   Frete[]   @relation("FreteEnderecoDestino")

  @@index([cidade, estado])
  @@map("enderecos")
}

// ============================================================================
// CLIENTES (extensão 1:1 de User)
// ============================================================================

model Cliente {
  userId String @id @map("usuario_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enderecoId String?   @map("endereco_id")
  endereco   Endereco? @relation(fields: [enderecoId], references: [id])

  createdAt DateTime @default(now()) @map("criado_em")

  fretes Frete[]

  @@map("clientes")
}

// ============================================================================
// MOTORISTAS / FRETISTAS (extensão 1:1 de User)
// ============================================================================

model Motorista {
  userId String @id @map("usuario_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cnhNumero        String?  @unique @map("cnh_numero")
  cnhNumeroMascarado String? @map("cnh_numero_mascarado")
  cnhCategoria     String?  @map("cnh_categoria")
  cnhValidade      DateTime? @map("cnh_validade") @db.Date
  avaliacaoMedia   Decimal  @default(0) @map("avaliacao_media") @db.Decimal(3, 2)
  totalAvaliacoes  Int      @default(0) @map("total_avaliacoes")
  disponivel       Boolean  @default(true)
  cadastroStatus   String?  @map("cadastro_status")
  nomeCompleto     String?  @map("nome_completo")
  tipoPessoa       String?  @map("tipo_pessoa")
  documentoMascarado String? @map("documento_mascarado")
  cnpjMascarado    String?  @map("cnpj_mascarado")
  nomeEmpresa      String?  @map("nome_empresa")
  cnhFotoDataUrl   String?  @map("cnh_foto_data_url") @db.Text
  documentosEnviados Boolean @default(false) @map("documentos_enviados")
  enviadoEm        DateTime? @map("enviado_em")
  revisadoEm       DateTime? @map("revisado_em")
  feedback         String?  @db.Text

  createdAt DateTime @default(now()) @map("criado_em")

  veiculos               Veiculo[]
  propostas              Proposta[]
  fretesComoSelecionado  Frete[]    @relation("FreteMotoristaSelecionado")

  @@index([disponivel])
  @@map("motoristas")
}

// ============================================================================
// VEÍCULOS
// ============================================================================

model Veiculo {
  id           String @id @default(cuid())
  motoristaId  String @map("motorista_id")
  motorista    Motorista @relation(fields: [motoristaId], references: [userId], onDelete: Cascade)
  ofertas      OfertaProposta[]

  placa              String  @unique
  modelo             String
  marca              String?
  anoFabricacao      Int?    @map("ano_fabricacao")
  categoriaPorte     Porte   @map("categoria_porte")
  carroceriaFechada  Boolean @default(false) @map("carroceria_fechada")
  capacidadeKg       Decimal? @map("capacidade_kg") @db.Decimal(10, 2)
  descricao          String   @default("")
  ativo              Boolean @default(true)

  createdAt DateTime @default(now()) @map("criado_em")

  @@index([motoristaId])
  @@index([categoriaPorte])
  @@map("veiculos")
}

// ============================================================================
// FRETES (pedidos cadastrados pelos clientes)
// ============================================================================

model Frete {
  id String @id @default(cuid())

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [userId])

  titulo             String
  descricao          String?
  categoriaPorte     Porte       @map("categoria_porte")
  carroceriaFechada  Boolean     @default(false) @map("carroceria_fechada")
  statusFrete        StatusFrete @default(ABERTO) @map("status_frete")

  enderecoOrigemId  String   @map("endereco_origem_id")
  enderecoOrigem    Endereco @relation("FreteEnderecoOrigem", fields: [enderecoOrigemId], references: [id])

  enderecoDestinoId String   @map("endereco_destino_id")
  enderecoDestino   Endereco @relation("FreteEnderecoDestino", fields: [enderecoDestinoId], references: [id])

  dataColetaPrevista  DateTime? @map("data_coleta_prevista") @db.Date
  dataEntregaPrevista DateTime? @map("data_entrega_prevista") @db.Date
  valorReferencia     Decimal?  @map("valor_referencia") @db.Decimal(10, 2)

  motoristaSelecionadoId String?    @map("motorista_selecionado_id")
  motoristaSelecionado   Motorista? @relation("FreteMotoristaSelecionado", fields: [motoristaSelecionadoId], references: [userId])
  acordo                 AcordoFrete?

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  fotos      FreteFoto[]
  propostas  Proposta[]
  avaliacoes Avaliacao[]
  mensagens  Mensagem[]

  @@index([statusFrete])
  @@index([clienteId])
  @@index([categoriaPorte])
  @@map("fretes")
}

// ============================================================================
// FOTOS DO FRETE
// ============================================================================

model FreteFoto {
  id       String @id @default(cuid())
  freteId  String @map("frete_id")
  frete    Frete  @relation(fields: [freteId], references: [id], onDelete: Cascade)

  url   String
  ordem Int    @default(0)

  createdAt DateTime @default(now()) @map("criado_em")

  @@unique([freteId, ordem])
  @@map("frete_fotos")
}

// ============================================================================
// PROPOSTAS
// ============================================================================

model Proposta {
  id String @id @default(cuid())

  freteId String @map("frete_id")
  frete   Frete  @relation(fields: [freteId], references: [id], onDelete: Cascade)

  motoristaId String    @map("motorista_id")
  motorista   Motorista @relation(fields: [motoristaId], references: [userId])

  valorProposto  Decimal        @map("valor_proposto") @db.Decimal(10, 2)
  mensagem       String?
  statusProposta StatusProposta @default(PENDENTE) @map("status_proposta")
  ofertas        OfertaProposta[]
  mensagens      Mensagem[]
  acordos        AcordoFrete[]

  createdAt DateTime @default(now()) @map("criado_em")
  updatedAt DateTime @updatedAt @map("atualizado_em")

  @@unique([freteId, motoristaId])
  @@index([statusProposta])
  @@map("propostas")
}

// ============================================================================
// AVALIAÇÕES
// ============================================================================

model Avaliacao {
  id String @id @default(cuid())

  freteId String @map("frete_id")
  frete   Frete  @relation(fields: [freteId], references: [id], onDelete: Cascade)

  avaliadorId String @map("avaliador_id")
  avaliadoId  String @map("avaliado_id")
  avaliador   User   @relation("AvaliacaoAvaliador", fields: [avaliadorId], references: [id], onDelete: Cascade)
  avaliado    User   @relation("AvaliacaoAvaliado", fields: [avaliadoId], references: [id], onDelete: Cascade)

  nota       Int
  comentario String?
  publica    Boolean @default(false)
  perfilAvaliador String @default("cliente") @map("perfil_avaliador")

  createdAt DateTime @default(now()) @map("criado_em")

  @@unique([freteId, avaliadorId, avaliadoId])
  @@index([avaliadoId])
  @@map("avaliacoes")
}

// ============================================================================
// MENSAGENS (chat por frete)
// ============================================================================

model Mensagem {
  id String @id @default(cuid())

  freteId String @map("frete_id")
  frete   Frete  @relation(fields: [freteId], references: [id], onDelete: Cascade)

  remetenteId    String  @map("remetente_id")
  destinatarioId String  @map("destinatario_id")
  remetente      User    @relation("MensagemRemetente", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario   User    @relation("MensagemDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  propostaId     String? @map("proposta_id")
  proposta       Proposta? @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  perfilRemetente String @default("cliente") @map("perfil_remetente")
  conteudo       String
  lida           Boolean @default(false)

  createdAt DateTime @default(now()) @map("criado_em")

  @@index([freteId, createdAt])
  @@map("mensagens")
}

model SavedAddress {
  id          String @id @default(cuid())
  userId      String @map("usuario_id")
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  logradouro  String
  numero      String
  complemento String
  bairro      String
  cidade      String
  estado      String @db.Char(2)
  cep         String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now()) @map("criado_em")
  updatedAt   DateTime @updatedAt @map("atualizado_em")

  @@index([userId])
  @@map("enderecos_salvos")
}

model DriverCompanyProfile {
  userId    String @id @map("usuario_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeName String @map("nome_fantasia")
  logo      String @db.Text
  about     String @db.Text
  city      String
  updatedAt DateTime @updatedAt @map("atualizado_em")

  @@map("perfis_empresa")
}

model OperatingArea {
  userId   String @id @map("usuario_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  radiusKm Decimal @map("raio_km") @db.Decimal(8, 2)
  label    String
  updatedAt DateTime @updatedAt @map("atualizado_em")

  @@map("areas_atuacao")
}

model OfertaProposta {
  id            String @id
  propostaId    String @map("proposta_id")
  proposta      Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  veiculoId     String? @map("veiculo_id")
  veiculo       Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)
  veiculoLabel  String @map("veiculo_label")
  valorCentavos Int @map("valor_centavos")
  disponivelEm  DateTime @map("disponivel_em")
  mensagem     String @db.Text
  status       String
  createdAt    DateTime @default(now()) @map("criado_em")

  @@index([propostaId, createdAt])
  @@map("ofertas_proposta")
}

model AcordoFrete {
  freteId       String @id @map("frete_id")
  frete         Frete @relation(fields: [freteId], references: [id], onDelete: Cascade)
  propostaId    String @map("proposta_id")
  proposta      Proposta @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  ofertaId      String @map("oferta_id")
  motoristaId   String @map("motorista_id")
  motorista     User @relation("AcordoMotorista", fields: [motoristaId], references: [id], onDelete: Restrict)
  nomeMotorista String @map("nome_motorista")
  nomePrestador String? @map("nome_prestador")
  tipoPrestador String? @map("tipo_prestador")
  valorCentavos Int @map("valor_centavos")
  veiculo       String
  disponivelEm  DateTime @map("disponivel_em")
  mensagem      String @db.Text
  aceitoEm      DateTime @map("aceito_em")

  @@map("acordos_frete")
}

model AppNotification {
  id         String
  userId     String @map("usuario_id")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String @map("perfil")
  title      String @map("titulo")
  body       String @db.Text
  createdAt  DateTime @map("criado_em")
  read       Boolean @default(false) @map("lida")
  freightId  String @map("frete_id")
  proposalId String? @map("proposta_id")

  @@id([userId, id])
  @@index([userId, createdAt])
  @@map("notificacoes")
}

model AdminReview {
  id        String @id
  caseUserId String @map("usuario_caso_id")
  caseUser  User   @relation(fields: [caseUserId], references: [id], onDelete: Cascade)
  version   String
  actor     String
  at        DateTime
  decision  String
  reason    String @db.Text

  @@index([caseUserId, at])
  @@map("revisoes_cadastro")
}

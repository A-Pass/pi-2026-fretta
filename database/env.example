# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/frete_app"

# Better Auth
BETTER_AUTH_SECRET="gere-com: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > Credenciais > OAuth Client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In (developer.apple.com > Certificates, Identifiers & Profiles)
APPLE_CLIENT_ID=""            # Services ID
APPLE_CLIENT_SECRET=""        # JWT assinado com a chave privada (.p8) da Apple
APPLE_APP_BUNDLE_IDENTIFIER="" # necessário apenas para apps iOS nativos
